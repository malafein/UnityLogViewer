<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0: loads in any Mono Unity game from 2018.1 on (they ship netstandard.dll).
         Compiled against Unity 2019.4 so newer-only Unity APIs cannot slip in. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnityLogViewer</AssemblyName>
    <Description>In-game log viewer for BepInEx</Description>
    <Version>0.0.3</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.31" IncludeAssets="compile" />
  </ItemGroup>
</Project>
